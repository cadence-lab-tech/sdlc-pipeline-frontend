# Статика интерфейса внутри контейнера ui. TLS и маршрутизация к сервису —
# у внешнего Caddy (backend/deploy/Caddyfile), сюда приходит уже http.
#
# Один адрес — :8080, непривилегированный (CLAB-248): образ работает не от
# root и без capabilities, поэтому в Kubernetes под Pod Security restricted
# ему хватает drop: [ALL]. Все, кто ходит в ui, ходят на ui:8080 — внешний
# Caddy нашего инстанса (backend/deploy) и пакета self-hosted.
{
	# В рантайме ui ничего не пишет: образ запускается на read-only корне,
	# в том числе без tmpfs, и в логе нет ни permission denied, ни ошибок
	# хранилища. Сертификатов у ui нет (адрес без имени хоста), поэтому:
	# - persist_config off — не сохранять конфиг в /config/caddy/autosave.json;
	# - storage_check off и storage_clean_interval off — не трогать хранилище
	#   TLS в /data (instance.uuid, блокировка чистки).
	persist_config off
	storage_check off
	storage_clean_interval off

	# За ui стоит внешний Caddy, к нему ходят по http/1.1; HTTP/2 и HTTP/3
	# без TLS всё равно не включаются, а так о них нет предупреждений.
	servers {
		protocols h1
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	# Правила кэша ставятся по ветке обработки, а не по пути исходного
	# запроса (CLAB-271): матчер `header /index.html` видит путь до того, как
	# try_files перепишет его на /index.html, поэтому / и маршруты SPA
	# уходили без Cache-Control, и браузер после апгрейда мог взять старый
	# index.html из эвристического кэша.

	# Хэшированные ассеты Vite. Существующий файл кэшируется вечно: имя
	# меняется вместе с содержимым. Отката на index.html здесь нет: чанк
	# старой версии, которого в образе уже нет, — 404 без долгого кэша, а не
	# HTML, закэшированный на год под URL скрипта. Заголовок — только с
	# матчером file: header без него ставится до file_server и остаётся и на
	# 404.
	handle /assets/* {
		@asset file
		header @asset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Всё остальное — index.html (/, /index.html и маршруты React Router:
	# /projects/SDLC/tasks/42) и файлы из public/ без хэша в имени (favicon,
	# иконки, manifest.webmanifest): no-cache, браузер перепроверяет их по
	# ETag на каждом запросе — на 200 и на 304 заголовок одинаков.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
